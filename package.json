{
  "name": "cortex-studio",
  "version": "0.5.0",
  "description": "Editor de video de escritorio con línea de tiempo multipista",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/electron.js .\"",
    "build": "vite build",
    "start": "vite build && node scripts/electron.js .",
    "icon": "node scripts/make-icon.js",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller": false
  },
  "author": "Illan Gonzalez Tellez",
  "license": "GPL-3.0-only",
  "build": {
    "appId": "com.nyra31.cortexstudio",
    "productName": "Cortex Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cortex Studio",
      "artifactName": "Cortex-Studio-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nyra31",
        "repo": "cortex-studio",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ]
  }
}
