{
  "name": "cortex-studio",
  "version": "0.1.0",
  "description": "Editor de video de escritorio con línea de tiempo multipista",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
